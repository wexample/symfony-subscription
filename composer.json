{
  "name": "wexample/symfony-subscription",
  "description": "Subscriptions for Symfony: an account on a plan, what it may still consume as the application measures it, refused once spent",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySubscription\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonySubscription\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "wexample/symfony-helpers": ">=19.2.0",
    "wexample/symfony-security": ">=4.0.2",
    "wexample/symfony-activity": ">=4.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  },
  "suggest": {
    "wexample/symfony-activity": "Keeps the subscription facts of each account — plans started, refusals — as its history"
  }
}